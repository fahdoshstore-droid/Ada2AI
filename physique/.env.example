# Ada2Physique frontend — environment variables (copy to .env.local)

# Supabase — shared Ada2AI project (auth.users + profiles + physique_* tables)
VITE_SUPABASE_URL=https://ujjmhqpyehymaavkawiv.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Ada2Physique backend (FastAPI, /physique/v1).
# Leave EMPTY in dev (Vite proxies /physique -> http://localhost:8080) or when a
# same-origin serverless function serves the API. For a remote backend (Cloud Run)
# set the FULL base INCLUDING the /physique/v1 prefix, e.g.:
#   VITE_PHYSIQUE_API_URL=https://ada2physique-backend-xxxx.run.app/physique/v1
VITE_PHYSIQUE_API_URL=
